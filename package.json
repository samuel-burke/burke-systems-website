{
  "engines": {
    "node": "26"
  },
  "name": "burke-systems-website",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "dev": "astro dev --host --ignore-lock",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "preinstall": "npx only-allow pnpm",
    "preview": "astro preview",
    "test": "vitest",
    "typecheck": "astro check",
    "test:unit": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "test:integration": "playwright test --project=integration",
    "test:e2e": "playwright test --project=e2e --project=e2e-mobile",
    "test:smoke": "playwright test --project=e2e --grep @readonly"
  },
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.34.1",
  "dependencies": {
    "@astrojs/react": "6.0.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  }
}

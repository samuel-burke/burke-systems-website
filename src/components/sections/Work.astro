---
import { Badge } from "@/components/ui/badge";
import { Card } from "@/components/ui/card";
import SectionHeading from "./SectionHeading.astro";

// TODO: swap the placeholder panels for real screenshots (put them in src/assets/work/).
const projects = [
  {
    kind: "WEB APP",
    title: "ShiftView",
    body: "A mobile-first scheduling app that shows retail fulfillment managers who is working, where, and when.",
    placeholder: "ShiftView screenshot",
    panel: "bg-night text-periwinkle",
  },
  {
    kind: "WEBSITE",
    title: "Family breeder site rebuild",
    body: "A full redesign for a family-owned Golden Retriever breeder: faster, easier to update, and built for phones.",
    placeholder: "Website screenshot",
    panel: "bg-mist text-burke-blue-hover",
  },
];
---

<section id="work" class="bg-paper" aria-labelledby="work-title">
  <div class="mx-auto flex max-w-[1200px] flex-col gap-11 px-4 py-20 sm:px-6 md:py-24">
    <SectionHeading id="work-title" eyebrow="RECENT WORK" title="Built for real teams." />
    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,320px),1fr))] gap-5">
      {
        projects.map((project) => (
          <Card className="gap-0 overflow-hidden rounded-[14px] border-0 py-0 shadow-none">
            <div class={`flex h-60 items-center justify-center text-sm font-semibold ${project.panel}`}>
              [{project.placeholder}]
            </div>
            <div class="flex flex-col gap-2.5 p-7">
              <Badge variant="secondary" className="bg-transparent px-0 text-[13px] font-semibold text-burke-blue">
                {project.kind}
              </Badge>
              <h3 class="text-[22px] font-bold">{project.title}</h3>
              <p class="text-base leading-relaxed text-muted-foreground">{project.body}</p>
            </div>
          </Card>
        ))
      }
    </div>
  </div>
</section>

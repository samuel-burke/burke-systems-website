---
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Textarea } from "@/components/ui/textarea";
import { INTAKE_LIMITS } from "@/lib/intake";
import { site } from "@/site";

const label = "text-sm font-semibold text-night";
const field = "h-11 bg-white text-base md:text-base";
---

<section id="contact" class="bg-burke-blue" aria-labelledby="contact-title">
  <div class="mx-auto flex max-w-[1200px] flex-wrap items-start justify-between gap-10 px-4 py-20 sm:px-6 md:py-22">
    <div class="flex min-w-0 flex-[1_1_360px] flex-col gap-3 lg:pt-6">
      <h2 id="contact-title" class="text-3xl leading-[1.1] font-extrabold text-balance text-white sm:text-4xl lg:text-[40px]">
        Got a process that eats your week?
      </h2>
      <p class="text-lg leading-relaxed text-[#E6EBFD]">
        Tell us about it. You don't pay anything until your software is finished and you're happy with it.
      </p>
      {
        site.earlyAccess && (
          <p class="text-[15px] leading-relaxed text-[#E6EBFD]">
            We're opening soon. Send an early-access request now and you'll be among our first clients.
          </p>
        )
      }
      <p class="text-[15px] leading-relaxed text-[#E6EBFD]">We'll read it and reply by email within two business days.</p>
      <div class="mt-3 flex flex-col gap-2">
        <p class="text-[15px] leading-relaxed text-[#E6EBFD]">Prefer email? Write to us directly.</p>
        <div class="flex w-fit max-w-full items-center rounded-lg border border-white/40 text-white">
          <a href={`mailto:${site.email}`} class="truncate px-4 py-3 font-semibold hover:underline">{site.email}</a>
          <button
            type="button"
            data-copy-email={site.email}
            class="min-w-[9ch] cursor-pointer self-stretch border-l border-white/40 px-4 text-sm text-[#E6EBFD] hover:text-white"
            aria-live="polite"
          >
            Copy
          </button>
        </div>
      </div>
    </div>

    <form
      method="post"
      action="/api/intake"
      class="flex w-full min-w-0 flex-[1_1_440px] flex-col gap-5 rounded-[14px] bg-white p-6 sm:p-8"
    >
      <div class="grid gap-5 sm:grid-cols-2">
        <div class="flex flex-col gap-2">
          <label for="intake-name" class={label}>Your name</label>
          <Input id="intake-name" name="name" autoComplete="name" required maxLength={INTAKE_LIMITS.name} className={field} />
        </div>
        <div class="flex flex-col gap-2">
          <label for="intake-email" class={label}>Email</label>
          <Input
            id="intake-email"
            name="email"
            type="email"
            autoComplete="email"
            required
            maxLength={INTAKE_LIMITS.email}
            className={field}
          />
        </div>
      </div>
      <div class="flex flex-col gap-2">
        <label for="intake-business" class={label}>Business name <span class="font-normal text-muted-foreground">(optional)</span></label>
        <Input
          id="intake-business"
          name="business"
          autoComplete="organization"
          maxLength={INTAKE_LIMITS.business}
          className={field}
        />
      </div>
      <div class="flex flex-col gap-2">
        <label for="intake-message" class={label}>What takes up too much of your time?</label>
        <Textarea
          id="intake-message"
          name="message"
          required
          rows={5}
          maxLength={INTAKE_LIMITS.message}
          placeholder="For example: we copy every order from email into a spreadsheet by hand."
          className="min-h-32 bg-white text-base md:text-base"
        />
      </div>
      {/* Honeypot: hidden from people, filled in by bots. */}
      <div class="hidden" aria-hidden="true">
        <label for="intake-website">Website</label>
        <input id="intake-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <Button type="submit" size="lg" className="h-12 w-full text-base sm:w-fit sm:px-8">
        {site.earlyAccess ? "Request early access" : "Send"}
      </Button>
    </form>
  </div>
</section>

<script>
  // Copy the address, as on samuelburke.dev. Without JavaScript the mailto link still works.
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy-email]")) {
    button.addEventListener("click", () => {
      const flash = (text: string) => {
        button.textContent = text;
        setTimeout(() => (button.textContent = "Copy"), 1500);
      };
      if (!navigator.clipboard) return flash("Couldn't copy");
      navigator.clipboard.writeText(button.dataset.copyEmail ?? "").then(
        () => flash("Copied"),
        () => flash("Couldn't copy"),
      );
    });
  }
</script>

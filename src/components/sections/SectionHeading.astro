---
type Props = {
  eyebrow: string;
  title: string;
  id?: string;
};

const { eyebrow, title, id } = Astro.props;
---

<div class="flex max-w-[640px] flex-col gap-3">
  <p class="text-[13px] font-semibold tracking-[0.18em] text-burke-blue">{eyebrow}</p>
  <h2 id={id} class="text-3xl leading-[1.1] font-extrabold text-balance sm:text-4xl lg:text-[40px]">{title}</h2>
</div>

# Variables the Pages Functions read. All are optional: without them the contact form
# still stores requests in D1, it just sends no alerts.
#
# In Cloudflare: set them per environment (Production and Preview) in the Pages project,
# Settings > Variables and Secrets, as encrypted secrets.
# Locally: `wrangler pages dev` reads them from a gitignored .dev.vars file in this format.
# Never commit real values. The D1 database is a binding named DB, not a variable.

# Email alerts through Resend. Both are needed to send.
RESEND_API_KEY=
INTAKE_NOTIFY_TO=
# Sender address. Defaults to Resend's test sender, which can only mail the Resend account owner.
INTAKE_NOTIFY_FROM=

# Push alerts through ntfy, e.g. https://ntfy.sh/<a-long-random-topic>
NTFY_TOPIC_URL=
# Only for a protected ntfy topic.
NTFY_TOKEN=
